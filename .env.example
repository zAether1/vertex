# ============================================
# Vertex — Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ── Database ──────────────────────────────────
POSTGRES_USER=vertex_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=vertex
DATABASE_URL=postgresql://vertex_admin:CHANGE_ME_TO_A_STRONG_PASSWORD@localhost:5432/vertex

# ── NextAuth / Auth.js ────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
NEXTAUTH_URL=http://localhost:3000

# ── OAuth: Google ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Rate Limiting (Upstash Redis for Production)
# Required for distributed rate limiting on Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Encryption Key (for reward secrets) ───────
# Generate with: openssl rand -hex 32
VERTEX_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Application ──────────────────────────────
NODE_ENV=development
